{
    "log": {
        "loglevel": "warning"
    },
    "dns": {
        "servers": [
            {
                "address": "1.1.1.1",
                "domains": ["geosite:geolocation-!ir"]
            },
            {
                "address": "156.154.70.1",
                "port": 53,
                "domains": ["geosite:ir"],
                "expectIPs": ["geoip:ir"]
            },
            "8.8.8.8",
            "localhost"
        ]
    },
    "inbounds": [
        {
            "port": 10808,
            "listen": "127.0.0.1",
            "protocol": "socks",
            "settings": {
                "udp": true
            },
            "sniffing": {
                "enabled": true,
                "destOverride": ["http", "tls", "quic"],
                "routeOnly": true
            }
        },
        {
            "port": 10809,
            "listen": "127.0.0.1",
            "protocol": "http"
        }
    ],
    "outbounds": [
        {
            "tag": "direct",
            "protocol": "freedom"
        },
        {
            "tag": "block",
            "protocol": "blackhole"
        }
    ],
    "routing": {
        "domainStrategy": "IPIfNonMatch",
        "domainMatcher": "mph",
        "rules": [
            {
                "type": "field",
                "outboundTag": "direct",
                "domain": ["geosite:ir"]
            },
            {
                "type": "field",
                "outboundTag": "direct",
                "ip": ["geoip:private", "geoip:ir"]
            },
            {
                "type": "field",
                "outboundTag": "block",
                "domain": ["geosite:category-ads-all"]
            }
        ]
    }
}
